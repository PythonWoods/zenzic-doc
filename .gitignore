.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.zenzic.local.toml

# ────────────────────────────────────────────────────────────────────────────
# AI Orchestration & Private Workspace (Zero-Leak Governance)
# ────────────────────────────────────────────────────────────────────────────
# Private Tech Lead workspace (formerly .draft)
.architect/
# Local AI routing rules (Trade Secret)
.clinerules
# Cursor AI rules (Trade Secret)
.cursorrules
# AI Primers and Memory ledgers
.github/agents/
# Legacy draft vaults
.draft/
/drafts/

# ────────────────────────────────────────────────────────────────────────────
# Node.js & Docusaurus (Build & Cache)
# ────────────────────────────────────────────────────────────────────────────
node_modules/
/build
.docusaurus/
.cache-loader/
.eslintcache
*.tsbuildinfo

# ────────────────────────────────────────────────────────────────────────────
# Zenzic & Python Artifacts (Local Testing & CI)
# ────────────────────────────────────────────────────────────────────────────
# Local core clone for CI/testing
_zenzic_core/
# Zenzic local cache
.zenzic_cache/
# Zenzic quality scores
.zenzic-score.json
# SARIF outputs
*.sarif
__pycache__/
.pytest_cache/
.coverage
.coverage.*
coverage.json
coverage.xml
mutmut*
.mutmut-cache/
.nox/
.hypothesis/

# ────────────────────────────────────────────────────────────────────────────
# Logs & Temporary Files
# ────────────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ────────────────────────────────────────────────────────────────────────────
# IDEs & Operating System
# ────────────────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ============================================================================
# End of .gitignore
